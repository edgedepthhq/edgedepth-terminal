{
  "$meta": {
    "name": "edgedepth design system",
    "version": "0.1.0",
    "updated": "2026-06-12",
    "mode": "dark-only",
    "description": "Near-black cool charcoal trading + replay terminal. Teal/magenta market data, viridis liquidation field, JetBrains Mono numerics. Source of truth = styles/edgedepth.css (:root + body[data-*]). This JSON mirrors it for tooling."
  },

  "color": {
    "surface": {
      "base":   { "value": "#05070a", "css": "--bg-base",   "use": "app background behind all panels" },
      "panel":  { "value": "#0a0e12", "css": "--bg-panel",  "use": "panel fill" },
      "elev":   { "value": "#0d1217", "css": "--bg-elev",   "use": "panel headers / elevated chrome" },
      "input":  { "value": "#11171d", "css": "--bg-input",  "use": "inputs, idle controls" },
      "hover":  { "value": "#161d25", "css": "--bg-hover",  "use": "hover state" },
      "active": { "value": "#1d2630", "css": "--bg-active", "use": "active / pressed / rails" }
    },
    "border": {
      "hair":   { "value": "rgba(150,168,184,0.07)", "css": "--bd-1", "use": "default hairline dividers" },
      "strong": { "value": "rgba(150,168,184,0.13)", "css": "--bd-2", "use": "control borders, emphasis" },
      "strongest": { "value": "rgba(150,168,184,0.22)", "css": "--bd-3", "use": "hover borders" },
      "grid":   { "value": "rgba(150,168,184,0.045)", "css": "--grid", "use": "chart gridlines" }
    },
    "text": {
      "primary":   { "value": "#e9eff5", "css": "--tx-1", "use": "prices, primary values" },
      "secondary": { "value": "#98aab8", "css": "--tx-2", "use": "labels, secondary data" },
      "tertiary":  { "value": "#5f6f7c", "css": "--tx-3", "use": "muted captions" },
      "faint":     { "value": "#3a4651", "css": "--tx-4", "use": "axis ticks, disabled" }
    },
    "semantic": {
      "up":    { "value": "#15c99e", "css": "--up",    "use": "up candle / bid / positive (teal)" },
      "down":  { "value": "#ff4d6d", "css": "--down",  "use": "down candle / ask / negative (magenta-rose)" },
      "brand": { "value": "#22c5db", "css": "--brand", "use": "focus, selection, replay accents, play control (cyan). Used sparingly." },
      "warn":  { "value": "#f3b24a", "css": "--warn",  "use": "replay/live badge, POC line, event flags (amber)" }
    },
    "alt_candle_conventions": {
      "_note": "set via body[data-candles]; default is 'teal'",
      "classic": { "up": "#26d07a", "down": "#ff4d5e" },
      "muted":   { "up": "#41a583", "down": "#cf6173" }
    },
    "alt_accents": {
      "_note": "set via body[data-accent]; default is 'teal' (brand #22c5db)",
      "indigo": "#6d8bff",
      "amber":  "#f3b24a",
      "mono":   "#aab8c4"
    }
  },

  "heatmap": {
    "liquidation": {
      "_note": "Default colormap = viridis. Engine should render the per-price x per-time field to a texture using this LUT, then composite BEHIND the candles. Low intensity fades to TRANSPARENT (charcoal shows through) - do not wash the whole chart purple.",
      "colormap": "viridis",
      "ramps": {
        "viridis": ["#440154", "#414487", "#2a788e", "#22a884", "#7ad151", "#fde725"],
        "magma":   ["#000004", "#3b0f70", "#8c2981", "#de4968", "#fe9f6d", "#fcfdbf"],
        "inferno": ["#000004", "#420a68", "#932667", "#dd513a", "#fca50a", "#fcffa4"]
      },
      "alpha": "intensity^1.15 * heatStrength (default 0.55), clamped ~0.92",
      "leverage_filters": [25, 50, 75, 100]
    },
    "dom_depth": {
      "_note": "DOM bid/ask size cells colored by the 'ocean' ramp: small=deep blue, large=green→yellow.",
      "ocean": ["#06101d", "#0e2f5e", "#1c6a8e", "#26a59a", "#7fd17a", "#eaf06a"]
    }
  },

  "type": {
    "fontFamilies": {
      "ui":   { "value": "'Hanken Grotesk', system-ui, -apple-system, sans-serif", "css": "--font-ui",  "use": "chrome, labels, headings" },
      "mono": { "value": "'JetBrains Mono', ui-monospace, monospace", "css": "--font-mono", "use": "ALL numerics. Always tabular: font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1, 'zero' 1" }
    },
    "scale_px": {
      "data-xs": 10, "data-sm": 11, "data": 11.5, "data-lg": 12,
      "label": 9.5, "heading-sm": 13, "heading": 17, "display": 30
    },
    "rules": ["Every figure uses mono + tabular numerals so columns align.", "Labels are 9.5px uppercase, letter-spacing 0.09em, color --tx-3."]
  },

  "radius_px": { "r1": 3, "r2": 5, "r3": 8, "pill": 999, "css": ["--r1", "--r2", "--r3", "--rp"] },

  "density": {
    "_note": "Density 8/10 is the chosen default. Driven by --row-h on :root.",
    "default": 8,
    "row_height_px": "26 - (density-3)*1.1  →  density 8 = 20.5px",
    "range": [3, 10]
  },

  "layout": {
    "topbar_h": 44,
    "statsbar_h": 33,
    "transport_h": 66,
    "watchlist_w": 254,
    "rightcol_w": 388,
    "indicator_pane_h": 172,
    "chart_axis": { "priceGutter_r": 66, "timeAxis_b": 22, "top": 6 }
  },

  "shadow": {
    "pop": "0 16px 50px -12px rgba(0,0,0,.7), 0 0 0 1px var(--bd-2)"
  }
}
