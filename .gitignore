# Build directories. Everything Emscripten emits lands in one of these, which
# is why this file does NOT blanket-ignore *.js, *.html, *.wasm or *.data.
# Those rules also swallowed src/shell.html, src/coi-serviceworker.js and
# src/closure_externs.js, which are SOURCE files the build depends on
# (--shell-file at CMakeLists.txt:528, the POST_BUILD copy at :635). The
# result was a repo nobody could build from a clean clone.
build/
build-*/
cmake-build-*/
_deps/

# In-tree Emscripten output, if CMake is configured at the repo root rather
# than in a build directory.
/index.js
/index.html
/index.wasm
/index.data
/index.worker.js

# Generated protobuf (C++ only)
src/pb/*.pb.h
src/pb/*.pb.cc
!src/pb/.gitkeep

# Compiled objects
*.o
*.a
*.so
*.dylib

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local-machine compose overrides (e.g. per-network trade-stream fallback)
docker-compose.override.yml

# Python bytecode from running the examples
__pycache__/
*.pyc
